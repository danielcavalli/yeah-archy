#!/bin/bash

# HDR-aware screenshot wrapper for Yeah Archy installs.
# Hyprland HDR screencopies can include the selection freeze/dim layer and
# export SDR screenshots too dark, so capture after teardown and lift RGB levels.

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${OMARCHY_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"

if [[ ! -d $OUTPUT_DIR ]]; then
  mkdir -p "$OUTPUT_DIR"
  notify-send "Created screenshot directory: $OUTPUT_DIR" -u normal -t 2000
fi

pkill slurp && exit 0

SCREENSHOT_EDITOR="${OMARCHY_SCREENSHOT_EDITOR:-satty}"

ARGS=()
for arg in "$@"; do
  if [[ $arg == --editor=* ]]; then
    SCREENSHOT_EDITOR="${arg#--editor=}"
  else
    ARGS+=("$arg")
  fi
done
set -- "${ARGS[@]}"

open_editor() {
  local filepath="$1"
  if [[ $SCREENSHOT_EDITOR == "satty" ]]; then
    satty --filename "$filepath" \
      --output-filename "$filepath" \
      --actions-on-enter save-to-clipboard \
      --save-after-copy \
      --copy-command 'wl-copy'
  else
    $SCREENSHOT_EDITOR "$filepath"
  fi
}

focused_output_is_hdr() {
  hyprctl monitors -j 2>/dev/null | jq -e '.[] | select(.focused == true and .colorManagementPreset == "hdr")' >/dev/null 2>&1
}

export_sdr_screenshot() {
  local input="$1"
  local output="$2"

  if ! focused_output_is_hdr || ! command -v magick >/dev/null 2>&1; then
    cp "$input" "$output"
    return
  fi

  local multiplier="${OMARCHY_SCREENSHOT_HDR_MULTIPLIER:-2.0}"
  [[ $multiplier =~ ^[0-9]+([.][0-9]+)?$ ]] || multiplier=2.0

  if ! magick "$input" -channel RGB -evaluate Multiply "$multiplier" +channel "$output"; then
    cp "$input" "$output"
  fi
}

MODE="${1:-smart}"
PROCESSING="${2:-slurp}"

JQ_MONITOR_GEO='
  def format_geo:
    .x as $x | .y as $y |
    (.width / .scale | floor) as $w |
    (.height / .scale | floor) as $h |
    .transform as $t |
    if $t == 1 or $t == 3 then
      "\($x),\($y) \($h)x\($w)"
    else
      "\($x),\($y) \($w)x\($h)"
    end;
'

get_rectangles() {
  local active_workspace
  active_workspace=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .activeWorkspace.id')
  hyprctl monitors -j | jq -r --arg ws "$active_workspace" "${JQ_MONITOR_GEO} .[] | select(.activeWorkspace.id == (\$ws | tonumber)) | format_geo"
  hyprctl clients -j | jq -r --arg ws "$active_workspace" '.[] | select(.workspace.id == ($ws | tonumber)) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
}

wait_for_selection_overlay() {
  local delay="${OMARCHY_SCREENSHOT_CAPTURE_DELAY:-0.2}"
  [[ $delay =~ ^[0-9]+([.][0-9]+)?$ ]] || delay=0.2
  sleep "$delay"
}

stop_picker() {
  local pid="$1"
  kill "$pid" 2>/dev/null || return 0
  wait "$pid" 2>/dev/null || true
  wait_for_selection_overlay
}

case "$MODE" in
region)
  hyprpicker -r -z >/dev/null 2>&1 &
  PID=$!
  sleep .1
  SELECTION=$(slurp 2>/dev/null)
  stop_picker "$PID"
  ;;
windows)
  hyprpicker -r -z >/dev/null 2>&1 &
  PID=$!
  sleep .1
  SELECTION=$(get_rectangles | slurp -r 2>/dev/null)
  stop_picker "$PID"
  ;;
fullscreen)
  SELECTION=$(hyprctl monitors -j | jq -r "${JQ_MONITOR_GEO} .[] | select(.focused == true) | format_geo")
  ;;
smart | *)
  RECTS=$(get_rectangles)
  hyprpicker -r -z >/dev/null 2>&1 &
  PID=$!
  sleep .1
  SELECTION=$(printf '%s\n' "$RECTS" | slurp 2>/dev/null)
  stop_picker "$PID"

  if [[ $SELECTION =~ ^([0-9]+),([0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]]; then
    if ((${BASH_REMATCH[3]} * ${BASH_REMATCH[4]} < 20)); then
      click_x="${BASH_REMATCH[1]}"
      click_y="${BASH_REMATCH[2]}"

      while IFS= read -r rect; do
        if [[ $rect =~ ^([0-9]+),([0-9]+)[[:space:]]([0-9]+)x([0-9]+) ]]; then
          rect_x="${BASH_REMATCH[1]}"
          rect_y="${BASH_REMATCH[2]}"
          rect_width="${BASH_REMATCH[3]}"
          rect_height="${BASH_REMATCH[4]}"

          if ((click_x >= rect_x && click_x < rect_x + rect_width && click_y >= rect_y && click_y < rect_y + rect_height)); then
            SELECTION="${rect_x},${rect_y} ${rect_width}x${rect_height}"
            break
          fi
        fi
      done <<<"$RECTS"
    fi
  fi
  ;;
esac

[[ -z $SELECTION ]] && exit 0

RAW_FILE=$(mktemp --suffix=.png)
trap 'rm -f "$RAW_FILE" "$CLIP_FILE"' EXIT

case "$PROCESSING" in
slurp)
  FILENAME="screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"
  FILEPATH="$OUTPUT_DIR/$FILENAME"

  grim -g "$SELECTION" "$RAW_FILE" || exit 1
  export_sdr_screenshot "$RAW_FILE" "$FILEPATH"
  echo "$FILEPATH"
  wl-copy --type image/png <"$FILEPATH" >/dev/null 2>&1

  (
    ACTION=$(notify-send "Screenshot saved to clipboard and file" "Edit with Super + Alt + , (or click this)" -t 10000 -i "$FILEPATH" -A "default=edit")
    [[ $ACTION == "default" ]] && open_editor "$FILEPATH"
  ) >/dev/null 2>&1 &
  ;;
copy)
  CLIP_FILE=$(mktemp --suffix=.png)
  grim -g "$SELECTION" "$RAW_FILE" || exit 1
  export_sdr_screenshot "$RAW_FILE" "$CLIP_FILE"
  wl-copy --type image/png <"$CLIP_FILE" >/dev/null 2>&1
  ;;
save)
  FILENAME="screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"
  FILEPATH="$OUTPUT_DIR/$FILENAME"

  grim -g "$SELECTION" "$RAW_FILE" || exit 1
  export_sdr_screenshot "$RAW_FILE" "$FILEPATH"
  echo "$FILEPATH"
  ;;
esac
